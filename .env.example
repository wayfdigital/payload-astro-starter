# =============================================================================
# Środowisko – skopiuj do `.env` i uzupełnij wartości
#   cp .env.example .env
# Zmienne NEXT_PUBLIC_* są wstrzykiwane w build (są publiczne / widoczne w przeglądarce).
# =============================================================================

# -----------------------------------------------------------------------------
# Core (wymagane)
# -----------------------------------------------------------------------------
# Connection string do Postgresa. Domyślne wartości pasują do docker-compose.yml.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/postgres

# Sekret Payloada do podpisywania tokenów/cookies. Wygeneruj losowy:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# -----------------------------------------------------------------------------
# URL aplikacji
# -----------------------------------------------------------------------------
# Publiczny URL serwera (admin, API, linki). Dev działa na porcie 3100 (patrz package.json).
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Bazowy URL używany m.in. jako fallback dla adresów mediów (S3/CDN).
NEXT_PUBLIC_URL=http://localhost:3100

# Ustawiane automatycznie przez Vercel – zostaw puste lokalnie.
# VERCEL_PROJECT_PRODUCTION_URL=

# -----------------------------------------------------------------------------
# CORS / dozwolone originy (lista po przecinku)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3100
NEXT_PUBLIC_ADMIN_ALLOWED_ORIGINS=http://localhost:3100
NEXT_PUBLIC_WEB_ALLOWED_ORIGINS=http://localhost:3100
NEXT_PUBLIC_DASHBOARD_ALLOWED_ORIGINS=http://localhost:3100

# -----------------------------------------------------------------------------
# Pierwszy administrator (skrypt seedujący – src/scripts/seed/users.ts)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Przechowywanie plików – S3 (kolekcja media; src/payload/config/plugins/s3.ts)
# -----------------------------------------------------------------------------
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Endpoint dla S3-kompatybilnych dostawców (MinIO, R2, Spaces). Dla AWS zostaw puste.
AWS_ENDPOINT_URL=
# Opcjonalny prefiks (folder) w buckecie.
AWS_PREFIX=
# Opcjonalny bazowy URL CDN dla mediów. Puste => używany jest NEXT_PUBLIC_URL.
NEXT_PUBLIC_MEDIA_CDN_BASE_URL=

# -----------------------------------------------------------------------------
# E-mail / SMTP (src/payload/config/mail.ts)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# reCAPTCHA (formularze – src/schemas/forms/recaptcha.ts)
# -----------------------------------------------------------------------------
# Klucz prywatny (server-side) do weryfikacji tokenu.
NEXT_PRIVATE_RECAPTCHA_SECRET_KEY=
# Klucz publiczny (site key) używany na froncie.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# Wygląd
# -----------------------------------------------------------------------------
# Aktywny motyw UI. Puste => domyślny 'ui-template'.
NEXT_PUBLIC_UI_THEME=

# -----------------------------------------------------------------------------
# Opcjonalne integracje (build-args w Dockerfile; włącz gdy potrzebne)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# Czy strona ma być indeksowana przez wyszukiwarki (true/false).
# NEXT_PUBLIC_SITE_INDEXABLE=
