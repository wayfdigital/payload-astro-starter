else
  export NODE_PATH="/Users/kacperzawojski/code/payload-starter/node_modules/.pnpm/dependency-cruiser@16.10.4/node_modules/dependency-cruiser/bin/node_modules:/Users/kacperzawojski/code/payload-starter/node_modules/.pnpm/dependency-cruiser@16.10.4/node_modules/dependency-cruiser/node_modules:/Users/kacperzawojski/code/payload-starter/node_modules/.pnpm/dependency-cruiser@16.10.4/node_modules:/Users/kacperzawojski/code/payload-starter/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../dependency-cruiser/bin/dependency-cruise.mjs" "$@"
else
  exec node  "$basedir/../dependency-cruiser/bin/dependency-cruise.mjs" "$@"
fi
