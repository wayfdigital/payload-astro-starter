# =============================================================================
# Environment – copy to `.env` and fill in the values
#   cp .env.example .env
# NEXT_PUBLIC_* variables are injected at build time (public / visible in the browser).
# =============================================================================

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------
# Postgres connection string. Defaults match docker-compose.yml.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/postgres

# Payload secret used to sign tokens/cookies. Generate a random one:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Public server URL (admin, API, links). Dev runs on port 3100 (see package.json).
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Base URL used, among others, as a fallback for media URLs (S3/CDN).
NEXT_PUBLIC_URL=http://localhost:3100

# Frontend (Astro) origin used to build preview / live-preview URLs.
ASTRO_PUBLIC_URL=http://localhost:3000
# Shared secret that gates the preview link. Must match PREVIEW_SECRET in apps/astro/.env.
PREVIEW_SECRET=

# Set automatically by Vercel – leave empty locally.
# VERCEL_PROJECT_PRODUCTION_URL=

# -----------------------------------------------------------------------------
# CORS / allowed origins (comma-separated list)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3000
NEXT_PUBLIC_ADMIN_ALLOWED_ORIGINS=http://localhost:3100
NEXT_PUBLIC_WEB_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3000
NEXT_PUBLIC_DASHBOARD_ALLOWED_ORIGINS=http://localhost:3100

# -----------------------------------------------------------------------------
# First administrator
# -----------------------------------------------------------------------------
# Login for the first admin. No admin is seeded: on a fresh database /admin shows
# the "create first user" screen. Either register there, or fill these two in and run
#   pnpm --filter @repo/payload payload run src/scripts/create-admin.ts
# The script refuses if an admin already exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Admin API key used by the Astro frontend for authenticated draft/preview reads.
# The first admin you register gets its API key pinned to EXACTLY this value
# (hook in src/payload/collections/Admins.ts), so preview works without generating
# a key in the admin UI. Use the SAME value as PAYLOAD_API_SECRET in
# apps/astro/.env. Generate one with: openssl rand -hex 32
PAYLOAD_API_SECRET=

# -----------------------------------------------------------------------------
# File storage – S3 (media collection; src/payload/config/plugins/s3.ts)
# -----------------------------------------------------------------------------
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Endpoint for S3-compatible providers (MinIO, R2, Spaces). Leave empty for AWS.
AWS_ENDPOINT_URL=
# Optional prefix (folder) inside the bucket.
AWS_PREFIX=
# Optional CDN base URL for media. Empty => NEXT_PUBLIC_URL is used.
NEXT_PUBLIC_MEDIA_CDN_BASE_URL=

# -----------------------------------------------------------------------------
# Email / SMTP (src/payload/config/mail.ts)
# -----------------------------------------------------------------------------
# Locally: Mailpit from docker-compose.yml (SMTP on 1025, no auth).
# Preview sent emails: http://localhost:8025
# In production set a real host/port + credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Default sender (optional).
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# -----------------------------------------------------------------------------
# reCAPTCHA (forms – src/schemas/forms/recaptcha.ts)
# -----------------------------------------------------------------------------
# Private key (server-side) used to verify the token.
NEXT_PRIVATE_RECAPTCHA_SECRET_KEY=
# Public key (site key) used on the frontend.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# Error monitoring – Sentry (src/payload/config/plugins/sentry.ts)
# -----------------------------------------------------------------------------
# Server-side DSN. The Sentry plugin is a no-op until this is set; once set it
# reports captured Payload errors. Get it from your Sentry project settings.
SENTRY_DSN=
# Browser-side DSN for @sentry/nextjs client instrumentation (often the same DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Optional – only needed to upload source maps during a production build.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------
# Active UI theme. Empty => default 'ui-template'.
NEXT_PUBLIC_UI_THEME=

# -----------------------------------------------------------------------------
# Optional integrations (build args in Dockerfile; enable when needed)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# Whether the site should be indexed by search engines (true/false).
# NEXT_PUBLIC_SITE_INDEXABLE=
