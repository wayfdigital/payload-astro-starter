# The build environment behind the October 2026 deploy, which published
# http://localhost:3000 as the canonical, og:url, og:image, hreflang, JSON-LD,
# robots.txt and sitemap origin of https://payload-astro-starter.wayf.ai.
# It is the dev value from .env.example; tests/seo-build.test.mjs builds with it
# and expects `astro build` to stop.
ASTRO_PUBLIC_SITE_URL=http://localhost:3000
