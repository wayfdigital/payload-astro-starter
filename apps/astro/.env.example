# URL of the running Payload CMS instance
PAYLOAD_API_URL=http://localhost:3100

# Public URL of this Astro site (used for canonical URLs / SEO meta).
ASTRO_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the Payload admin (used as the live-preview postMessage source and
# the `frame-ancestors` CSP that lets the admin embed this site in an iframe).
ASTRO_PUBLIC_ADMIN_ORIGIN=http://localhost:3100

# Shared secret that gates the preview link. Must match PREVIEW_SECRET in apps/payload/.env.
PREVIEW_SECRET=

# Admin API key used for authenticated server-side draft reads. No need to generate
# one in the admin UI — Payload seeds the first admin with EXACTLY this value on init
# (apps/payload seedUsers). Just set the same value here and in apps/payload/.env.
# Generate one with: openssl rand -hex 32
PAYLOAD_API_SECRET=
