---
import '@repo/ui/styles/theme.css';
import '@repo/ui/styles/globals.css';
import type { Page, SiteSetting } from '@repo/payload-types';
import LivePreviewListener from '../components/preview/live-preview-listener';
import PreviewBanner from '../components/preview/preview-banner.astro';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import CustomCode from '../components/seo/CustomCode.astro';
import { ADMIN_ORIGIN } from '../lib/preview-env';
import WayfBadge from '../components/elements/wayf-badge';
import type { ResolvedSeo } from '../lib/seo/meta';
// Dev-only: raw source of the browser debug-capture, inlined below. The
// `import.meta.env.DEV` guard + `?raw` import tree-shake this out of prod builds.
import browserCaptureSrc from '../lib/debug/browser-capture.ts?raw';

interface Props {
  /** Fully-resolved SEO values (build with `buildSeo` in the page). */
  seo: ResolvedSeo;
  /** schema.org objects rendered as JSON-LD (nullish entries are dropped). */
  jsonLd?: unknown[];
  /** Admin-authored custom code injected at the four page edges. */
  customCode?: SiteSetting['customCode'];
  /** When true, mount the live-preview listener + banner (set on preview/draft renders). */
  preview?: boolean;
  /** Status of the document on screen — drives the banner's wording. Preview only. */
  previewStatus?: Page['_status'];
  /**
   * Floating "Built by WAYF" credit. Turn it off on a page that already shows the
   * badge in its own content, so the two don't sit on screen at once.
   */
  credit?: boolean;
}

const {
  seo,
  jsonLd = [],
  customCode,
  preview = false,
  previewStatus,
  credit = true,
} = Astro.props;
---

<!doctype html>
<html lang={seo.locale}>
  <head>
    <CustomCode html={customCode?.headStart} />
    <meta charset='UTF-8' />
    {
      import.meta.env.DEV && (
        <script
          is:inline
          define:vars={{ port: Number(import.meta.env.PUBLIC_DEBUG_SERVER_PORT ?? 7913), sessionId: 'dev' }}
          set:html={browserCaptureSrc}
        />
      )
    }
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#D6388A' />
    <link rel='icon' href='/favicon.ico' sizes='32x32' />
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <link rel='icon' href='/favicon-32x32.png' type='image/png' sizes='32x32' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' sizes='180x180' />
    <link rel='manifest' href='/site.webmanifest' />
    <Seo {...seo} />
    {jsonLd.length > 0 && <JsonLd schema={jsonLd} />}
    <CustomCode html={customCode?.headEnd} />
  </head>
  <body data-theme='ui'>
    <CustomCode html={customCode?.bodyStart} />
    {preview && <PreviewBanner status={previewStatus} />}
    <slot />
    {credit && <WayfBadge placement='floating' />}
    {
      preview && (
        <LivePreviewListener client:only='react' adminOrigin={ADMIN_ORIGIN} />
      )
    }
    <CustomCode html={customCode?.bodyEnd} />
  </body>
</html>
