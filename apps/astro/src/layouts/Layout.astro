---
import '@repo/ui/styles/theme.css';
import '@repo/ui/styles/globals.css';
import type { SiteSetting } from '@repo/payload-types';
import LivePreviewListener from '../components/preview/live-preview-listener';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import CustomCode from '../components/seo/CustomCode.astro';
import { ADMIN_ORIGIN } from '../lib/preview-env';
import WayfLogo from '../components/elements/WayfLogo.astro';
import type { ResolvedSeo } from '../lib/seo/meta';
// Dev-only: raw source of the browser debug-capture, inlined below. The
// `import.meta.env.DEV` guard + `?raw` import tree-shake this out of prod builds.
import browserCaptureSrc from '../lib/debug/browser-capture.ts?raw';

interface Props {
  /** Fully-resolved SEO values (build with `buildSeo` in the page). */
  seo: ResolvedSeo;
  /** schema.org objects rendered as JSON-LD (nullish entries are dropped). */
  jsonLd?: unknown[];
  /** Admin-authored custom code injected at the four page edges. */
  customCode?: SiteSetting['customCode'];
  /** When true, mount the live-preview listener (set on preview/draft renders). */
  preview?: boolean;
}

const { seo, jsonLd = [], customCode, preview = false } = Astro.props;
---

<!doctype html>
<html lang={seo.locale}>
  <head>
    <CustomCode html={customCode?.headStart} />
    <meta charset='UTF-8' />
    {
      import.meta.env.DEV && (
        <script
          is:inline
          define:vars={{ port: Number(import.meta.env.PUBLIC_DEBUG_SERVER_PORT ?? 7913), sessionId: 'dev' }}
          set:html={browserCaptureSrc}
        />
      )
    }
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <Seo {...seo} />
    {jsonLd.length > 0 && <JsonLd schema={jsonLd} />}
    <CustomCode html={customCode?.headEnd} />
  </head>
  <body data-theme='ui'>
    <CustomCode html={customCode?.bodyStart} />
    <slot />
    <footer class='wayf-credit'>
      <a
        class='wayf-credit__link'
        href='https://wayf.ai'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Built by WAYF — wayf.ai'
      >
        <span>Built by</span>
        <WayfLogo class='wayf-credit__mark' />
        <strong class='wayf-credit__name'>WAYF</strong>
      </a>
    </footer>
    {
      preview && (
        <LivePreviewListener client:only='react' adminOrigin={ADMIN_ORIGIN} />
      )
    }
    <CustomCode html={customCode?.bodyEnd} />
  </body>
</html>

<style>
  /* Subtle, site-wide "Built by WAYF" credit. Layout/text use the host theme's
     muted tokens; the mark keeps WAYF's own brand colors. */
  .wayf-credit {
    border-top: 1px solid var(--border);
    padding: var(--spacing-lg) var(--spacing-md);
    text-align: center;
  }

  .wayf-credit__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .wayf-credit__link:hover {
    color: var(--foreground);
  }

  .wayf-credit__mark {
    display: block;
    border-radius: 4px;
    flex: none;
  }

  .wayf-credit__name {
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.02em;
  }
</style>
