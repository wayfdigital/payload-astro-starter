---
import Layout from '../layouts/Layout.astro';
import StarterGuide from '../components/starter-guide/starter-guide';
import { absoluteUrl, buildSeo } from '../lib/seo/meta';
import { organizationSchema, websiteSchema } from '../lib/seo/jsonld';
import { DEFAULT_LOCALE } from '../i18n/locales';

// Static landing page for the starter itself — no CMS behind it, so it is
// prerendered at build time and served as plain HTML (no SSR, no Payload fetch).
// Wiring the home page to the CMS again means: drop `prerender`, load the page
// with `getHomePage(locale, { draft: preview })` and render it through
// <PageBuilder /> — see src/pages/[...slug].astro, which still does exactly that.
export const prerender = true;

const seo = buildSeo(
  {
    title: 'Payload CMS + Astro Starter for Agent-Led Builds | WAYF',
    description:
      'Build production-ready websites with Payload CMS and Astro. Get reusable blocks, safe migrations, localization, SEO, live preview and Cloudflare deployment.',
    slug: '',
    locale: DEFAULT_LOCALE,
    type: 'website',
    siteName: 'WAYF',
    alternateLocales: [DEFAULT_LOCALE],
    socialImage: {
      src: '/og-image.png',
      alt: 'WAYF logo on a pink background',
      width: 1200,
      height: 630,
      type: 'image/png',
    },
  },
  null,
);

const jsonLd = [
  websiteSchema(null, 'Payload CMS + Astro Starter'),
  organizationSchema(null, {
    name: 'WAYF',
    url: 'https://wayf.ai',
    logo: absoluteUrl('/icon-512.png'),
    sameAs: ['https://github.com/wayfdigital'],
  }),
];
---

<Layout seo={seo} jsonLd={jsonLd} credit={false}>
  {/* Carries the WAYF badge in its own hero, hence credit={false} above. */}
  <StarterGuide client:load />
</Layout>

{/* Landing-only brand typography: wayf.ai sets display and body in Schibsted
   Grotesk, with a system mono for technical labels. Scoped here (this style
   ships only with the landing) so the design system and CMS pages keep their
   own defaults. */}
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap');
  [data-theme='ui'] {
    --font-sans: 'Schibsted Grotesk', system-ui, -apple-system, sans-serif;
    --font-heading: 'Schibsted Grotesk', system-ui, -apple-system, sans-serif;
    --font-mono: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
  }
</style>
