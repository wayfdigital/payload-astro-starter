---
import Layout from '../layouts/Layout.astro';
import StarterGuide from '../components/starter-guide/starter-guide';
import { absoluteUrl, buildSeo } from '../lib/seo/meta';
import { organizationSchema, websiteSchema } from '../lib/seo/jsonld';
import { DEFAULT_LOCALE } from '../i18n/locales';

// Static landing page for the starter itself — no CMS behind it, so it is
// prerendered at build time and served as plain HTML (no SSR, no Payload fetch).
// Wiring the home page to the CMS again means: drop `prerender`, load the page
// with `getHomePage(locale, { draft: preview })` and render it through
// <PageBuilder /> — see src/pages/[...slug].astro, which still does exactly that.
export const prerender = true;

const seo = buildSeo(
  {
    title: 'Payload CMS + Astro Starter for Agent-Led Builds | WAYF',
    description:
      'Build production-ready websites with Payload CMS and Astro. Get reusable blocks, safe migrations, localization, SEO, live preview and Cloudflare deployment.',
    slug: '',
    locale: DEFAULT_LOCALE,
    type: 'website',
    siteName: 'WAYF',
    alternateLocales: [DEFAULT_LOCALE],
    socialImage: {
      src: '/og-image.png',
      alt: 'WAYF logo on a pink background',
      width: 1200,
      height: 630,
      type: 'image/png',
    },
  },
  null,
);

const jsonLd = [
  websiteSchema(null, 'Payload CMS + Astro Starter'),
  organizationSchema(null, {
    name: 'WAYF',
    url: 'https://wayf.ai',
    logo: absoluteUrl('/icon-512.png'),
    sameAs: ['https://github.com/wayfdigital'],
  }),
];
---

<Layout seo={seo} jsonLd={jsonLd} credit={false} dark>
  <StarterGuide />
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-setup-prompt');
  const prompt = document.querySelector<HTMLTextAreaElement>('#setup-prompt');
  const status = document.querySelector<HTMLParagraphElement>('#setup-prompt-status');
  const details = document.querySelector<HTMLDetailsElement>('#setup-prompt-details');

  if (button && prompt && status && details) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        await navigator.clipboard.writeText(prompt.value);
        status.textContent = 'Copied. Paste it into your coding agent.';
      } catch {
        details.open = true;
        prompt.focus();
        prompt.select();
        status.textContent = 'Copy the selected prompt, then paste it into your coding agent.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
