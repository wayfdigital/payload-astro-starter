---
import Layout from '../layouts/Layout.astro'
import PageBuilder from '../components/page-builder/page-builder.astro'
import { getPageBySlug } from '../lib/payload/pages'
import { getSiteSettings } from '../lib/payload/site-settings'
import { buildSeo } from '../lib/seo/meta'
import { webPageSchema, breadcrumbSchema } from '../lib/seo/jsonld'
import { DEFAULT_LOCALE, isLocale, type Locale } from '../i18n/locales'

const apiUrl = import.meta.env.PAYLOAD_API_URL ?? 'http://localhost:3100'
const recaptchaSiteKey = import.meta.env.RECAPTCHA_SITE_KEY

// The slug is non-localized: the same page exists in every locale, only its
// content differs. A leading `/<locale>/` segment selects which locale to fetch
// (`/about` = en, `/pl/about` = pl).
const segments = (Astro.params.slug ?? '').split('/').filter(Boolean)
let locale: Locale = DEFAULT_LOCALE
const first = segments[0]
if (first !== undefined && isLocale(first)) {
  locale = first
  segments.shift()
}
const slug = segments.join('/')

// In preview the iframe URL has no locale prefix, so `?locale=` selects the locale.
const preview = Astro.locals.preview === true
const localeParam = Astro.url.searchParams.get('locale')
if (preview && localeParam !== null && isLocale(localeParam)) {
  locale = localeParam
}

// A bare `/<locale>` with no page slug → send to the home page.
if (!slug) {
  return Astro.redirect('/')
}

const [page, settings] = await Promise.all([
  getPageBySlug(slug, locale, { draft: preview }),
  getSiteSettings(locale),
])

if (!page) {
  Astro.response.status = 404
}

const seo = buildSeo(
  {
    title: page?.meta?.title ?? page?.slug ?? 'Page not found',
    description: page?.meta?.description,
    image: page?.meta?.image,
    slug,
    locale,
    type: 'website',
    // Drafts/preview and the not-found state must never be indexed.
    noindex: preview || !page,
  },
  settings,
)

const jsonLd = page
  ? [
      webPageSchema({
        title: seo.title,
        description: seo.description,
        url: seo.canonical,
        image: seo.ogImage,
      }),
      breadcrumbSchema(page.breadcrumbs, locale),
    ]
  : []

const customCode = settings?.customCode
---

<Layout seo={seo} jsonLd={jsonLd} customCode={customCode} preview={preview}>
  {
    page ? (
      <PageBuilder page={page} apiUrl={apiUrl} recaptchaSiteKey={recaptchaSiteKey} locale={locale} />
    ) : (
      <main style="padding: var(--spacing-xl); max-width: var(--max-width); margin: 0 auto;">
        <h1 style="font-family: var(--font-heading); color: var(--foreground);">Page not found</h1>
        <p style="color: var(--muted-foreground); margin-top: var(--spacing-md);">
          No page exists at <code>/{slug}</code>.
        </p>
        <a href="/" style="color: var(--primary); text-decoration: underline;">Back home</a>
      </main>
    )
  }
</Layout>
