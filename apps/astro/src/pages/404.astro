---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page not found">
  <main style="padding: var(--spacing-xl); max-width: var(--max-width); margin: 0 auto; text-align: center;">
    <h1 style="font-family: var(--font-heading); color: var(--foreground); font-size: 3rem;">404</h1>
    <p style="color: var(--muted-foreground); margin-top: var(--spacing-md);">
      The page you're looking for doesn't exist.
    </p>
    <a href="/" style="color: var(--primary); text-decoration: underline; display: inline-block; margin-top: var(--spacing-lg);">
      Back home
    </a>
  </main>
</Layout>
