---
import type { Page } from '@repo/payload-types'
import type { Locale } from '../../i18n/locales'
import HeroSection from '../sections/hero/index'
import LayoutSections from './layout-sections.astro'

/**
 * Renders a full CMS page: the `hero` group followed by the `layout` blocks.
 */
interface Props {
  page: Page
  /** Payload REST base URL, forwarded to interactive sections (FormBlock). */
  apiUrl: string
  /** Active locale, forwarded so CMS links resolve to locale-prefixed hrefs. */
  locale: Locale
}

const { page, apiUrl, locale } = Astro.props
---

<HeroSection {...page.hero} locale={locale} />
<LayoutSections sections={page.layout} apiUrl={apiUrl} locale={locale} />
