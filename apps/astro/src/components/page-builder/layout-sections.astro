---
import type { Page } from '@repo/payload-types'
import type { Locale } from '../../i18n/locales'
import ExampleBlockSection from '../sections/example-block/index'
import PageContentSection from '../sections/page-content/index'
import FormBlockSection from '../sections/form-block/index'

/**
 * Maps each CMS `layout` block to its renderer (the Astro-native "layout builder").
 * Static sections render as server-side React (no JS shipped); the interactive
 * FormBlock is hydrated as an island via `client:load`.
 */
interface Props {
  sections?: Page['layout']
  /** Payload REST base URL, forwarded to the FormBlock island. */
  apiUrl: string
  /** reCAPTCHA v3 site key, forwarded to the FormBlock island. */
  recaptchaSiteKey?: string
  /** Active locale, forwarded so CMS links resolve to locale-prefixed hrefs. */
  locale: Locale
}

const { sections, apiUrl, recaptchaSiteKey, locale } = Astro.props
---

{
  sections?.map((section) => {
    switch (section.blockType) {
      case 'exampleBlock':
        return <ExampleBlockSection {...section} locale={locale} />
      case 'page-content-1':
      case 'page-content-2':
      case 'page-content-3':
        return <PageContentSection {...section} locale={locale} />
      case 'formBlock':
        return (
          <FormBlockSection
            client:load
            {...section}
            apiUrl={apiUrl}
            recaptchaSiteKey={recaptchaSiteKey}
          />
        )
      default:
        return null
    }
  })
}
