{
  "name": "zavcode-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:clean": "pnpm run db:down && pnpm run db:up",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}