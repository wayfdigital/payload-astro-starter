# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js (apps/payload)
apps/payload/.next/
apps/payload/out/

# astro (apps/astro)
apps/astro/dist/
apps/astro/.astro/

# build outputs
/build
/dist

# typescript
*.tsbuildinfo
next-env.d.ts

# testing / coverage
/coverage

# logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the example committed)
.env
.env.*
!.env.example

# payload — locally stored media uploads (S3 is used in prod)
/media
/uploads

# docker — local postgres volume (see docker-compose.yml)
/.volume

# vercel
.vercel

# OS / editor
.DS_Store
*.pem
Thumbs.db
.idea
*.swp

# claude code — local-only overrides
.claude/settings.local.json

# dependency-cruiser — generated graph
/dependency-graph.svg

# local MCP config (contains a dev token)
.mcp.json

# Storybook
storybook-static/
