{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".dependency-cruiser.cjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ASTRO_PUBLIC_SITE_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "cache": false
    },
    "depcruise": {},
    "generate:types": {
      "cache": false
    }
  }
}
